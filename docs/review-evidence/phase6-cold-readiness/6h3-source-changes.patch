@@ -0,0 +1,142 @@
+use std::{error::Error, future::Future, io, time::Duration};
+
+// A Ready Service may precede kube-proxy programming its new endpoint. A refused
+// TCP connect proves no stream was established and no application bytes were sent.
+// The caller MUST enclose this future in its existing total setup/handshake timeout.
+// Never use this loop around a protocol handshake or a request/response future.
+pub(crate) async fn retry_refused_connect<F, Fut, T, E>(mut connect: F) -> Result<T, E>
+where
+    F: FnMut() -> Fut,
+    Fut: Future<Output = Result<T, E>>,
+    E: Error + 'static,
+{
+    loop {
+        match connect().await {
+            Err(error) if is_connection_refused(&error) => {
+                tokio::time::sleep(Duration::from_millis(50)).await;
+            }
+            result => return result,
+        }
+    }
+}
+
+fn is_connection_refused(error: &(dyn Error + 'static)) -> bool {
+    if let Some(error) = error.downcast_ref::<io::Error>() {
+        return error.kind() == io::ErrorKind::ConnectionRefused;
+    }
+    error.source().is_some_and(is_connection_refused)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::{
+        atomic::{AtomicUsize, Ordering},
+        Arc,
+    };
+
+    #[tokio::test]
+    async fn a_real_refusal_can_precede_bind_without_dispatching_bytes() {
+        let reservation = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let addr = reservation.local_addr().unwrap();
+        drop(reservation);
+        let refused = Arc::new(tokio::sync::Notify::new());
+        let observed = refused.clone();
+        let calls = Arc::new(AtomicUsize::new(0));
+        let task_calls = calls.clone();
+        let task = tokio::spawn(async move {
+            tokio::time::timeout(
+                Duration::from_secs(1),
+                retry_refused_connect(|| {
+                    let attempt = task_calls.fetch_add(1, Ordering::SeqCst);
+                    let observed = observed.clone();
+                    async move {
+                        let result = tokio::net::TcpStream::connect(addr).await;
+                        if attempt == 0 {
+                            assert_eq!(
+                                result.as_ref().unwrap_err().kind(),
+                                io::ErrorKind::ConnectionRefused
+                            );
+                            observed.notify_one();
+                        }
+                        result
+                    }
+                }),
+            )
+            .await
+            .unwrap()
+            .unwrap()
+        });
+        tokio::time::timeout(Duration::from_secs(1), refused.notified())
+            .await
+            .unwrap();
+        let listener = tokio::net::TcpListener::bind(addr).await.unwrap();
+        let connection = task.await.unwrap();
+        let (mut accepted, _) = listener.accept().await.unwrap();
+        assert!(calls.load(Ordering::SeqCst) >= 2);
+        drop(connection);
+        use tokio::io::AsyncReadExt;
+        assert_eq!(accepted.read(&mut [0; 1]).await.unwrap(), 0);
+    }
+
+    #[tokio::test(start_paused = true)]
+    async fn refusal_attempts_share_one_outer_deadline() {
+        let calls = AtomicUsize::new(0);
+        let result = tokio::time::timeout(
+            Duration::from_millis(120),
+            retry_refused_connect(|| {
+                calls.fetch_add(1, Ordering::SeqCst);
+                std::future::ready(Err::<(), _>(io::Error::from(
+                    io::ErrorKind::ConnectionRefused,
+                )))
+            }),
+        )
+        .await;
+        assert!(result.is_err());
+        assert_eq!(calls.load(Ordering::SeqCst), 3);
+    }
+
+    #[tokio::test(start_paused = true)]
+    async fn cancellation_stops_refusal_retries() {
+        let calls = Arc::new(AtomicUsize::new(0));
+        let task_calls = calls.clone();
+        let task = tokio::spawn(async move {
+            tokio::time::timeout(
+                Duration::from_secs(1),
+                retry_refused_connect(|| {
+                    task_calls.fetch_add(1, Ordering::SeqCst);
+                    std::future::ready(Err::<(), _>(io::Error::from(
+                        io::ErrorKind::ConnectionRefused,
+                    )))
+                }),
+            )
+            .await
+        });
+        tokio::task::yield_now().await;
+        assert_eq!(calls.load(Ordering::SeqCst), 1);
+        task.abort();
+        assert!(task.await.unwrap_err().is_cancelled());
+        tokio::time::advance(Duration::from_secs(2)).await;
+        assert_eq!(calls.load(Ordering::SeqCst), 1);
+    }
+
+    #[tokio::test]
+    async fn non_refusal_connect_errors_are_not_retried() {
+        for kind in [
+            io::ErrorKind::ConnectionReset,
+            io::ErrorKind::TimedOut,
+            io::ErrorKind::PermissionDenied,
+            io::ErrorKind::NotFound,
+        ] {
+            let calls = AtomicUsize::new(0);
+            let error = retry_refused_connect(|| {
+                calls.fetch_add(1, Ordering::SeqCst);
+                std::future::ready(Err::<(), _>(io::Error::from(kind)))
+            })
+            .await
+            .unwrap_err();
+            assert_eq!(error.kind(), kind);
+            assert_eq!(calls.load(Ordering::SeqCst), 1);
+        }
+    }
+}
