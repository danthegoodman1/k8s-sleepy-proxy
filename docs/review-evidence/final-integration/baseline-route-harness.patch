+#[derive(Debug)]
+struct BenchObservationSink;
+impl proxy_core::observability::recorder::ObservabilitySink for BenchObservationSink {
+    fn record(&self, event: proxy_core::observability::recorder::ObservabilityEvent) {
+        black_box(event);
+    }
+}
