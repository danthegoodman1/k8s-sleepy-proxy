+#[tokio::test]
+async fn review_probe_refresh_buffered_invalidation_reaches_production_drain() {
+    let mut client = test_client(FakeProxyControlPlane::default());
+    let (requests, _request_rx) = mpsc::channel(16);
+    let (event_tx, responses) = mpsc::channel(16);
+    client.subscription = Some(super::GrpcRouteSubscriptionSession {
+        requests,
+        responses,
+        buffered_updates: VecDeque::new(),
+        pending_route_responses: Arc::new(tokio::sync::Mutex::new(std::collections::HashMap::new())),
+    });
+    event_tx.send(super::GrpcRouteSubscriptionEvent::Message(SubscribeControlPlaneOutput::RouteInvalidated { subscription_id: subscription_id("old"), reason: InvalidationReason::RouteRemoved })).await.unwrap();
+    client.refresh_subscription_status().unwrap();
+    let events = client.drain_subscription_events().await.unwrap();
+    assert_eq!(events.len(), 1, "refresh must not hide invalidations from the resolver event-drain path");
+}
