+#[tokio::test]
+async fn review_probe_wildcard_cache_must_not_hide_preexisting_exact_route() {
+    let mut client = FakeRouteClient::default();
+    client.push_subscribe_response(resolved_response(request_id("req:1"), subscription_id("broad"), http_rule("example.com", None), route_entry(InstanceState::Running, 7, Some(1))));
+    client.push_subscribe_response(resolved_response(request_id("req:2"), subscription_id("exact"), http_request("private.example.com", "/"), route_entry(InstanceState::Running, 7, Some(2))));
+    let mut coordinator = coordinator_with_state(SubscriptionState::new(8), client, FakeWakeClient::default());
+    coordinator.route(http_request("public.example.com", "/"), now()).await.unwrap();
+    let outcome = coordinator.route(http_request("private.example.com", "/"), now()).await.unwrap();
+    let FrontlineRouteOutcome::Ready(actual) = outcome else { panic!("expected ready"); };
+    assert_eq!(actual.backend, backend(2), "the control plane has an exact route, but the broad cache suppresses its lookup");
+}
